{
  "manifest_version": 3,
  "name": "AutoFlow Studio Recorder",
  "version": "0.1.0",
  "description": "Record and replay browser workflows from the active tab without an AI API.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoFlow Studio",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}